<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Emby plugins target netstandard2.0 for cross-platform compatibility across Windows, Linux, and NAS -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Litefin.Emby.Plugin</RootNamespace>
    <AssemblyName>Litefin.Emby.Plugin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.12.0.3</AssemblyVersion>
    <FileVersion>1.12.0.3</FileVersion>
    <InformationalVersion>1.12.0.3</InformationalVersion>
    <Description>Litefin server plugin for Emby Server, providing optimized Hero carousel, merged rows, batch item queries, settings backups, and Seerr proxy.</Description>
      <Version>1.12.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Canonical Emby Server Core SDK -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <!-- Reconcile System.Memory assembly version across dependencies and MediaBrowser.Controller -->
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <!-- High-performance JSON parser supporting netstandard2.0 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded administrative configuration web page, JS controller, and icons -->
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\litefin.js" />
    <EmbeddedResource Include="Configuration\litefin.js" />
    <None Remove="ThumbImage.png" />
    <EmbeddedResource Include="ThumbImage.png" Condition="Exists('ThumbImage.png')" />
  </ItemGroup>

</Project>
